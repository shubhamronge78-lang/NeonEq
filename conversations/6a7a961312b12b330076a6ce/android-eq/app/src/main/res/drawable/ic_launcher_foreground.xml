<?xml version="1.0" encoding="utf-8"?>
<!-- SonicCore adaptive-icon foreground: SC monogram + waveform.
     C = open cyan ring, S = violet sine through the core.
     Stroke-based so it stays legible at small launcher sizes. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- C ring: open on the right (centered 54,54, r=27) -->
    <path
        android:pathData="M 70,33 A 27,27 0 1 0 70,75"
        android:strokeColor="#00E5FF"
        android:strokeWidth="6.5"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- S waveform: sine through the core -->
    <path
        android:pathData="M 40,54 C 45,44 50,64 54,54 C 58,44 63,64 68,54"
        android:strokeColor="#7C4DFF"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:fillColor="#00000000" />

    <!-- core dot: the processing core -->
    <path
        android:pathData="M 54,54 m -2.4,0 a 2.4,2.4 0 1 0 4.8,0 a 2.4,2.4 0 1 0 -4.8,0"
        android:fillColor="#00E5FF" />
</vector>
